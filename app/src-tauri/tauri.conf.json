{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLAST Broadcaster",
  "identifier": "fr.black-lab.blast",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BLAST Broadcaster",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/background-*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Loïc HERAUDEAU (D-Goth)",
    "copyright": "Copyright (c) 2026 Loïc HERAUDEAU (D-Goth) — https://black-lab.fr",
    "homepage": "https://github.com/D-Goth/BLAST-Broadcaster",
    "category": "Music",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Console d'antenne pour webradio et live",
    "longDescription": "BLAST (Black-Lab Audio Streaming Tool) : deux platines avec pochette, pitch et pré-écoute, playlist, grilles horaires, auto-mix, micro avec effets de voix et ducking, diffusion Icecast et SHOUTcast, pilotage d'OBS et chat live.",
    "linux": {
      "deb": {
        "section": "sound",
        "desktopTemplate": "../../packaging/linux/blast-broadcaster.desktop.hbs",
        "files": {
          "/usr/share/metainfo/fr.black-lab.blast.metainfo.xml": "../../packaging/linux/fr.black-lab.blast.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/fr.black-lab.blast.metainfo.xml": "../../packaging/linux/fr.black-lab.blast.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3OTlBOTY0QTdCMjlBRTIKUldUaW1yS25aS21aSjBLUDYwRnoxL0Jzd0F2Ykd2MS9zdGFxU3I1VC9oQkR5d2xETXVBZzNFNkYK",
      "endpoints": [
        "https://github.com/D-Goth/BLAST-Broadcaster/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
