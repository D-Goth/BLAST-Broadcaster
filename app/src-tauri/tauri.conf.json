{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLAST Broadcaster",
  "identifier": "fr.black-lab.blast",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BLAST Broadcaster",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/background-*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3OTlBOTY0QTdCMjlBRTIKUldUaW1yS25aS21aSjBLUDYwRnoxL0Jzd0F2Ykd2MS9zdGFxU3I1VC9oQkR5d2xETXVBZzNFNkYK",
      "endpoints": [
        "https://github.com/D-Goth/BLAST-Broadcaster/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
